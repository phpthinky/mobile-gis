{
    "namespace": "Gis",

    "bridge_functions": [
        {
            "name": "Gis.GetCurrentLocation",
            "android": "com.nativephp.gis.GpsFunctions.GetCurrentLocation",
            "ios": "GpsFunctions.GetCurrentLocation",
            "description": "Get the device's current GPS location"
        }
    ],

    "android": {
        "min_version": 26,
        "permissions": [
            "android.permission.ACCESS_FINE_LOCATION",
            "android.permission.ACCESS_COARSE_LOCATION"
        ],
        "dependencies": {
            "implementation": [
                "com.google.android.gms:play-services-location:21.3.0"
            ]
        },
        "services": []
    },

    "ios": {
        "min_version": "18.2",
        "info_plist": {
            "NSLocationWhenInUseUsageDescription": "This app requires location access to get your current GPS position.",
            "NSLocationAlwaysAndWhenInUseUsageDescription": "This app requires location access to get your current GPS position."
        },
        "dependencies": {
            "swift_packages": [],
            "pods": []
        }
    },

    "events": [
        "Native\\Mobile\\Events\\Gis\\LocationReceived",
        "Native\\Mobile\\Events\\Gis\\LocationPermissionDenied",
        "Native\\Mobile\\Events\\Gis\\LocationError"
    ]
}
