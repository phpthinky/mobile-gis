{
    "name": "nativephp/mobile-gis",
    "description": "Mobile GIS plugin for NativePHP Mobile (GPS location, map drawing, polygon, markers)",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "*"
    },
    "autoload": {
        "psr-4": {
            "Native\\Mobile\\Providers\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Native\\Mobile\\Providers\\GisServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    }
}
